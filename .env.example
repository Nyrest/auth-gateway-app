# Generate with: bun src/scripts/generate-secret.ts
# Copy only the 43-character output; do not add quotes, spaces, or '=' padding.
AUTH_GATEWAY_SECRET=

# Required for Docker and migration tooling. Cloudflare uses HYPERDRIVE instead.
DATABASE_URL=postgresql://auth_gateway@127.0.0.1:5432/auth_gateway

# Optional for Docker only; defaults to 3000.
# PORT=3000
