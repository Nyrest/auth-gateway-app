# Generate with: bun run secret:generate
AUTH_GATEWAY_SECRET=

# Required for Docker and migration tooling. Cloudflare uses HYPERDRIVE instead.
DATABASE_URL=postgresql://auth_gateway:auth_gateway@127.0.0.1:5432/auth_gateway

# Optional for Docker only; defaults to 3000.
# PORT=3000

# Required by docker-compose.yml. Use an unpadded base64url value so it is safe
# to embed in the Compose PostgreSQL URL.
POSTGRES_PASSWORD=
