{
  "name": "auth-gateway-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --config vite.bun.config.ts --port 3000",
    "dev:cloudflare": "vite dev --port 3000",
    "generate-routes": "tsr generate",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --is-server 'import.meta.env.SSR' --emit-ts-declarations --silent",
		"build": "bun run i18n:compile && vite build",
		"build:cloudflare": "bun run i18n:compile && vite build",
		"build:docker": "bun run i18n:compile && vite build --config vite.bun.config.ts",
		"start:docker": "bun src/runtime/bun/server.ts",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint .",
    "check": "biome check .",
		"typecheck": "tsc --noEmit",
		"check:runtime-boundaries": "bun src/scripts/check-runtime-boundaries.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "secret:generate": "bun src/scripts/generate-secret.ts",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/start-storage-context": "^1.167.29",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@tanstack/intent": "^0.3.7",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
